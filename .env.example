# Docker Compose project name. Compose prefixes container and network names with it (quro-db-1,
# quro_backend-net). Data lives in bind mounts under ./data, so it is not tied to this name.
# Use a different name for a second stack on the same host, and keep it stable afterwards:
# changing it starts a new set of containers and networks next to the old ones.
COMPOSE_PROJECT_NAME=quro
QRO_FRONTEND_PORT=3000

# Database
POSTGRES_DB=quro
POSTGRES_ADMIN_USER=quro_admin
POSTGRES_APP_USER=quro_app

# Document storage (docs/document-storage.md)
# filesystem: uploaded documents are files in ./data/documents, mounted into the backend.
# s3: an S3-compatible store you run. Set the S3_* settings below and mount the secret file
# S3_SECRET_ACCESS_KEY_FILE names (default /run/secrets/s3_secret_access_key) with a Compose
# override. S3 settings without QRO_DOCUMENT_STORAGE stop the backend instead of guessing.
QRO_DOCUMENT_STORAGE=filesystem
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=eu-west-1
# S3_BUCKET=quro-documents
# S3_ACCESS_KEY_ID=
# S3_FORCE_PATH_STYLE=true

# Core app runtime
# Deployment mode (docs/security.md#deployment-modes). Mode A, plain HTTP on a private
# network: keep SECURE_COOKIES=false. Mode B, HTTPS at your reverse proxy: set it to true.
SECURE_COOKIES=false
# Who may create an account once the first one exists. The first account always needs a
# setup code from `docker compose exec backend quro user invite`.
#   invite (default): a single-use code from `quro user invite` per new account
#   closed: no new accounts
#   open: anyone who can reach Quro can sign up
QRO_REGISTRATION_MODE=invite
# Set HOST to restrict which interface the backend binds to (default: 0.0.0.0 in dev, 127.0.0.1 in Docker)
# HOST=127.0.0.1
# How often expired sessions are purged from the database in milliseconds (default: 86400000 = 24 hours)
# SESSION_CLEANUP_INTERVAL_MS=86400000
# Proxies allowed to set X-Real-IP / X-Forwarded-For for rate limiting (comma-separated IPs or IPv4 CIDRs).
# Unset trusts none. Compose defaults to 172.16.0.0/12, Docker's default network range, which
# covers the bundled nginx. In mode B, also list the address your reverse proxy connects to
# nginx from if it is outside that range (docs/security.md#proxy-trust).
# TRUSTED_PROXIES=172.16.0.0/12
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
PENSION_PARSER_INTERNAL_URL=http://pension-parser:8080
PENSION_PARSER_TIMEOUT_MS=300000
IMPORT_DRAFT_TTL_DAYS=7
IMPORT_WORKER_POLL_INTERVAL_MS=3000

# Optional OpenTelemetry tracing (backend). Unset keeps it off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=quro-backend

# Optional bunq OAuth integration. Leave all of these unset to run Quro without bunq
# linking; the UI then reports the integration as unavailable. Setting any of
# BUNQ_CLIENT_ID, BUNQ_CLIENT_SECRET or BUNQ_REDIRECT_URI requires all four, otherwise
# the backend refuses to start. It also needs the secrets key that encrypts stored bank-link
# secrets, mounted into the backend as a secret named secrets_key (docs/development.md).
# FRONTEND_ORIGIN=http://localhost:3000
# BUNQ_CLIENT_ID=
# BUNQ_CLIENT_SECRET=
# BUNQ_REDIRECT_URI=http://localhost:3000/api/bunq/oauth/callback
# BUNQ_SANDBOX=true

# Optional single sign-on through an OpenID Connect provider (docs/configuration.md#single-sign-on).
# Leave all of these unset to run with passwords only. Setting any of OIDC_ISSUER, OIDC_CLIENT_ID,
# OIDC_CLIENT_SECRET or OIDC_REDIRECT_URI requires all four, otherwise the backend refuses to start.
# OIDC_CLIENT_SECRET can also come from the file OIDC_CLIENT_SECRET_FILE.
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=quro
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# OIDC_PROVIDER_NAME=SSO
# Set to false to turn Quro's own passwords off so the provider is the only way in; the backend
# refuses to start without the OIDC_* settings. Accounts are then created with `quro user create`
# (docs/security.md#single-sign-on-only-mode). Set it back to true and run `docker compose up -d` to restore passwords.
# QRO_PASSWORD_LOGIN=true

# Optional, experimental statement OCR: `docker compose --profile ocr up`
# (docs/development.md#optional-pension-import-development).
PARSER_ALLOW_REGEX_FALLBACK=true
PARSER_REGEX_ONLY=false
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
VLLM_TIMEOUT_SECONDS=180
VLLM_GPU_MEMORY_UTILIZATION=0.92
VLLM_MAX_MODEL_LEN=8192
VLLM_INTERNAL_BASE_URL=http://vllm:8000
# 1 once the model is in data/vllm-cache: the model server then never downloads.
# VLLM_HF_HUB_OFFLINE=0
# VLLM_CPUS=4
# VLLM_MEM_LIMIT=24g
# Bounds for one document. Keep PARSER_TIMEOUT_SECONDS + VLLM_TIMEOUT_SECONDS below
# PENSION_PARSER_TIMEOUT_MS (in seconds).
# PARSER_MAX_FILE_MB=20
# PARSER_MAX_PAGES=30
# PARSER_MAX_PAGE_PIXELS=40000000
# PARSER_MAX_TEXT_CHARS=80000
# PARSER_TIMEOUT_SECONDS=100
# PARSER_CPU_SECONDS=100
# PARSER_MEMORY_MB=1024
# PARSER_MAX_CONCURRENCY=1
# PARSER_MAX_QUEUE=2
# PARSER_CPUS=2
# PARSER_MEM_LIMIT=2g
