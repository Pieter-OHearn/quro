#!/bin/sh
# The image's entry point: `quro <command>`. The server and the worker replace this shell so they
# receive the container's signals directly; every other command runs the operator command line.
set -eu

cd /app/packages/backend
case "${1:-}" in
  serve)
    if [ "$#" -eq 1 ]; then exec bun src/index.ts; fi
    ;;
  worker)
    if [ "$#" -eq 2 ] && [ "$2" = "pension-imports" ]; then
      exec bun src/workers/pensionImportWorker.ts
    fi
    ;;
esac
exec bun src/cli/quro.ts "$@"
